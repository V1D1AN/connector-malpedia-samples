opencti:
  url: "http://localhost:8080"
  token: "ChangeMe"

connector:
  id: "ChangeMe"                     # uuidgen
  type: "EXTERNAL_IMPORT"
  name: "Malpedia Samples"
  scope: "artifact,malware"
  log_level: "info"
  duration_period: "P7D"             # ISO 8601 — toutes les semaines

malpedia:
  auth_key: "ChangeMe"               # Clé API Malpedia (compte de confiance requis)
  sample_format: "both"              # raw | zip | both
  families_filter: ""                # vide = toutes, sinon: "win.cobalt_strike,win.mimikatz"
  unpacked_only: false               # true = seulement unpacked/dumped
  labels: "malpedia"                 # labels à appliquer aux artifacts
  labels_color: "#7f3b08"
  tlp: "TLP:AMBER"                   # TLP:WHITE, TLP:CLEAR, TLP:GREEN, TLP:AMBER, TLP:RED
  import_intrusion_sets: true        # créer/lier les Intrusion Sets (acteurs)
  import_yara: true                  # créer les YARA Indicators
  download_delay: 1                  # secondes entre chaque download (politesse API)
